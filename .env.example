# ---------- API ----------
ENV=dev
QICORE_DEBUG=1

# ---------- Auth (multi-client) ----------
QICORE_API_KEYS={"qk_live_abc123":"cliente_01","qk_live_def456":"cliente_02"}

# ---------- Mongo (opcional por ahora) ----------
MONGODB_URI=
MONGODB_DB=qicore
MONGODB_COLLECTION=qicore_logs

# ---------- QiCore thresholds ----------
QICORE_ETA=0.5
QICORE_LAMBDA2=2.0
QICORE_H_THRESHOLD=1.0
QICORE_SIGMA_KNOWN=0.08
QICORE_SIGMA_BORDER=0.30
QICORE_BETA_NEG_BORDER=0.20
QICORE_MISSION_WEIGHT_OOD=0.0

# ---------- Safe message ----------
QICORE_SAFE_MESSAGE=No tengo evidencia suficiente para responder con confianza. ¿Puedes entregar más contexto o una fuente verificable?
